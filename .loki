# frozen_string_literal: true
# sqa-sinatra — Sinatra web UI for SQA with ApexCharts.js interactive charts.

import_up "repo_dev.loki"

class Tasks
  @@gem_name ||= "sqa-sinatra".freeze

  header "sqa-sinatra v#{gem_version} — SQA web UI (Sinatra)"

  desc "Start the web server at http://localhost:9292"
  def server
    sh "bundle exec rackup"
  end
end
